# reader-inbox environment. Copy into Vercel (Project → Settings → Environment Variables), or to .env.local for `vercel dev`.
# Never commit real values: .gitignore ignores every .env* file except this one.

# Shared secret for every endpoint (?k=, Bearer, or OPDS Basic password). Make one with: openssl rand -hex 24
READER_KEY=
# Upstash Redis REST URL where articles are stored; the Vercel Upstash integration sets it for you.
KV_REST_API_URL=
# Upstash Redis REST token; set by the integration too. (UPSTASH_REDIS_REST_URL / _TOKEN also work instead of the KV_ pair.)
KV_REST_API_TOKEN=
